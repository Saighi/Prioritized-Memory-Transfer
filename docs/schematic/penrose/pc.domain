-- Domain: the *vocabulary* of a predictive-coding circuit.
-- Mirrors docs/schematic/spec.py (value vs error neurons, prediction vs error edges).

type Neuron
type Value
type Error
Value <: Neuron
Error <: Neuron

predicate Predicts(Neuron a, Neuron b)   -- top-down prediction edge (blue)
predicate Errors(Neuron a, Neuron b)     -- bottom-up / drive edge   (orange)
predicate Recurrent(Neuron n)            -- node carries a recurrent weight (W)

-- layout intent (Penrose has no fixed coordinates; we express order as relations)
predicate Above(Neuron a, Neuron b)
predicate LeftOf(Neuron a, Neuron b)
