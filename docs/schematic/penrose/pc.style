-- Style: how the vocabulary is drawn. Penrose then *optimizes* the layout.
-- STARTER: verify/tweak in the editor (see README.md). Edge gain-labels (pi_T, x_T,
-- pi_ST<0, ...) and curved separation of the parallel pairs are the remaining polish —
-- this is exactly the manual effort that the comparison flags Penrose for.

canvas {
  width = 760
  height = 720
}

forall Value v {
  v.icon = Circle {
    r : 30.0
    fillColor : none()
    strokeColor : rgba(0.13, 0.13, 0.13, 1.0)
    strokeWidth : 2.0
  }
  v.text = Equation {
    string : v.label
    center : v.icon.center
    fontSize : "22px"
  }
  layer v.text above v.icon
}

forall Error e {
  e.icon = Rectangle {
    width : 76.0
    height : 48.0
    fillColor : none()
    strokeColor : rgba(0.53, 0.53, 0.53, 1.0)
    strokeWidth : 1.5
    cornerRadius : 9.0
    strokeStyle : "dashed"
  }
  e.text = Equation {
    string : e.label
    center : e.icon.center
    fontSize : "20px"
  }
  layer e.text above e.icon
}

-- top-down prediction edges (blue)
forall Neuron a; Neuron b where Predicts(a, b) {
  a.pred = Line {
    start : a.icon.center
    end : b.icon.center
    strokeColor : rgba(0.298, 0.553, 1.0, 1.0)
    strokeWidth : 2.0
    endArrowhead : "straight"
  }
  layer a.icon above a.pred
  layer b.icon above a.pred
}

-- bottom-up / drive edges (orange)
forall Neuron a; Neuron b where Errors(a, b) {
  a.err = Line {
    start : a.icon.center
    end : b.icon.center
    strokeColor : rgba(0.878, 0.467, 0.169, 1.0)
    strokeWidth : 2.0
    endArrowhead : "straight"
  }
  layer a.icon above a.err
  layer b.icon above a.err
}

-- recurrent weight: a small loop marker above the value node
forall Neuron n where Recurrent(n) {
  n.loop = Circle {
    r : 11.0
    center : (n.icon.center[0], n.icon.center[1] + 44.0)
    fillColor : none()
    strokeColor : rgba(0.53, 0.53, 0.53, 1.0)
    strokeWidth : 1.5
  }
}

-- layout intent -> optimizer constraints
forall Neuron a; Neuron b where Above(a, b) {
  ensure a.icon.center[1] > b.icon.center[1] + 160.0
  encourage a.icon.center[0] == b.icon.center[0]
}
forall Neuron a; Neuron b where LeftOf(a, b) {
  ensure a.icon.center[0] + 150.0 < b.icon.center[0]
  encourage a.icon.center[1] == b.icon.center[1]
}
